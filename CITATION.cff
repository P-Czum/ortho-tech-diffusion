    affiliation: "Department of Orthopedics and Traumatology, Piekary Śląskie, Poland; Polish Association for Artificial Intelligence in Medicine"
version: "0.1.0"
date-released: "2026-08-26"
license: "CC-BY-4.0"
keywords:
  - bibliometrics
  - orthopaedics
  - technology diffusion
  - MEDLINE
  - MeSH
